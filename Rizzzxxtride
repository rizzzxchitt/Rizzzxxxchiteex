-- 1. MEMANGGIL UI LIBRARY RAYFIELD
local Rayfield = loadstring(game:HttpGet('https://sirius.menu'))()

-- 2. MEMBUAT JENDELA UTAMA
local Window = Rayfield:CreateWindow({
   Name = "Rizzzxxchiter | Violence District",
   LoadingTitle = "Memuat Skrip Premium...",
   LoadingSubtitle = "by Rizzzxxchiter",
   ConfigurationSaving = { Enabled = false }
})

-- 3. MEMBUAT TAB KATEGORI BARU
local TabCombat = Window:CreateTab("Combat & Aim", 4483362458) 
local TabVisuals = Window:CreateTab("Visuals / ESP", 4483362458)
local TabAutomation = Window:CreateTab("Automation", 4483362458)

-- =========================================================
-- TAB COMBAT: AUTO PARRY & AIM LOCK PISTOL
-- =========================================================
local AutoParryAktif = false
local AimLockAktif = false

-- Tombol Auto Parry
TabCombat:CreateToggle({
   Name = "Aktifkan Auto Parry",
   CurrentValue = false,
   Flag = "ToggleAutoParry", 
   Callback = function(Value)
      AutoParryAktif = Value
      if AutoParryAktif then
          task.spawn(function()
              while AutoParryAktif do
                  task.wait()
                  -- Logika deteksi jarak serangan masuk di sini
              end
          end)
      end
   end,
})

-- Tombol Aim Lock Pistol
